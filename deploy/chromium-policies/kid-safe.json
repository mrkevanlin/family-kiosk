{
  "ForceGoogleSafeSearch": true,
  "ForceYouTubeRestrict": 2,
  "SafeSitesFilterBehavior": 1,
  "IncognitoModeAvailability": 1,
  "BrowserGuestModeEnabled": false,
  "BrowserAddPersonEnabled": false,
  "PasswordManagerEnabled": true,
  "TranslateEnabled": false,
  "DefaultSearchProviderEnabled": true,
  "DefaultSearchProviderName": "Google SafeSearch",
  "DefaultSearchProviderSearchURL": "https://www.google.com/search?q={searchTerms}&safe=active&ssui=on",
  "DefaultSearchProviderSuggestURL": "https://www.google.com/complete/search?q={searchTerms}&safe=active&ssui=on",
  "URLBlocklist": [
    "https://www.google.com/search?*&safe=off*",
    "https://google.com/search?*&safe=off*",
    "https://images.google.com/imghp?*&safe=off*",
    "https://www.bing.com/*",
    "https://bing.com/*",
    "https://duckduckgo.com/*",
    "https://search.yahoo.com/*",
    "https://yandex.com/*"
  ]
}
