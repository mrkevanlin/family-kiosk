{
  "manifest_version": 3,
  "name": "Family Kiosk Activity Header",
  "version": "1.0.0",
  "description": "Adds a persistent return-to-picker control to kiosk activities.",
  "permissions": [],
  "host_permissions": ["https://*/*", "http://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://*/*", "http://*/*"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
